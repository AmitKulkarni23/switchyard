# Postgres connection string. Railway injects this from the Postgres service.
DATABASE_URL=postgres://user:password@localhost:5432/switchyard

# Private bucket for uploads (Railway Bucket / S3-compatible). Objects are deleted right after parsing.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
# Optional locally: without bucket vars uploads are parsed in memory only; without DATABASE_URL share links are off.

# Optional LLM fallback for unparsed lines. Disabled and unimplemented in v1; the app works without it.
LLM_FALLBACK_ENABLED=false
OPENROUTER_API_KEY=

# Injected by Railway
PORT=3000
