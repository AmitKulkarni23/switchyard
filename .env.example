# Postgres connection string. Railway injects this from the Postgres service.
DATABASE_URL=postgres://user:password@localhost:5432/switchyard

# Private bucket for uploads (Railway Bucket / S3-compatible). Objects are deleted right after parsing.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
# Optional locally: without bucket vars uploads are parsed in memory only; without DATABASE_URL share links are off.

# Optional: drafts designs from the idea box. Without it, the app offers starter designs instead. Bills never use it.
OPENROUTER_API_KEY=
# Optional: override the models that draft designs.
# DESIGN_PRIMARY_MODELS=z-ai/glm-5.3,deepseek/deepseek-v4-flash
# DESIGN_TIEBREAK_MODEL=openai/gpt-6.1-sol

# LLM fallback for unparsed bill lines. Disabled and unimplemented.
LLM_FALLBACK_ENABLED=false

# Injected by Railway
PORT=3000
